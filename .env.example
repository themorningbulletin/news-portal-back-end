# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string (Atlas or self-hosted). Include the database name.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://themorningbulletinbd_db_user:HYpBuFcKPRiIOe7z@cluster0.w6u0la9.mongodb.net/news-portal-khuka?retryWrites=true&w=majority

# Browser origins allowed to call the API directly (the site normally proxies /api/v1).
CORS_ORIGINS=http://localhost:3000
# Reverse-proxy hops in front of the API (Next.js rewrite = 1).
TRUST_PROXY=1
SESSION_DAYS=5

# Public site URL, used in emails and canonical checks (https in production).
WEB_BASE_URL=http://localhost:3000
# Frontend cache revalidation webhook and shared secret (32+ random characters).
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
# Shared with the frontend server (32+ chars) so its server-side reads are not rate-limited as one IP.
INTERNAL_API_KEY=

# Firebase Admin. Either a service account (below) or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=
# Easiest: path to the service-account JSON (Firebase console > Project settings > Service accounts).
FIREBASE_SERVICE_ACCOUNT_PATH=
# ...or the three fields separately:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local development only: the Firebase Auth emulator. Rejected when NODE_ENV=production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Cloudinary media storage (uploads are disabled until all three are set).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=the-morning-bulletin
# Vercel rejects request bodies over 4.5 MB, so stay below that there.
UPLOAD_MAX_BYTES=4000000

# SMTP for newsletter confirmation emails, e.g. smtps://user:pass@smtp.example.com:465
# Without it the newsletter is disabled in production (emails are only logged in development).
SMTP_URL=
MAIL_FROM=

# Serverless (Vercel): secret for GET /api/v1/internal/cron/scheduler, at least 32 characters.
CRON_SECRET=
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000
